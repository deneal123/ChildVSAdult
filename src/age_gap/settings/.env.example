VK_TOKEN=
GIGACHAT_SECRET=

# --- Reddit (второй, не-VK источник; r/PastAndPresentPics) ---
# OAuth НЕОБЯЗАТЕЛЕН: без этих переменных клиент скрейпит публичный .json
# (браузерные заголовки, www->old fallback) — с резидентного IP обычно работает.
# Если публичный режим даёт 403, заведите "script"-приложение на
# https://www.reddit.com/prefs/apps и заполните:
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=
