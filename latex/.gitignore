# LaTeX build artifacts (regenerated on compile)
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.spl
*.toc
*.fls
*.fdb_latexmk
*.lof
*.lot

# Archived leftover template files from an unrelated project
_attic/

# Third-party class/style kits (downloadable references, not project source).
# The IEEE build uses MiKTeX's IEEEtran; the AAAI build uses the copies committed
# inside conference/aaai-27/en/.
shared/vendor/

# Submission bundles: the self-contained manuscript/ + supplement/ archives are DERIVED
# from en/ + shared/ (rebuild with `python latex/build_submission.py <paper>`).
# The unique artifacts (title_page_en.docx, SUBMISSION.md, strip_comments.py) are tracked.
papers/journal-1-tnnls/submission/manuscript/
papers/journal-1-tnnls/submission/supplement/
papers/journal-1-tbiom/submission/manuscript/
papers/journal-1-tbiom/submission/supplement/
# COI и сопроводительное письмо: .tex отслеживаем, сборочный мусор и PDF — нет
papers/journal-1-tbiom/submission/*.aux
papers/journal-1-tbiom/submission/*.log
papers/journal-1-tbiom/submission/*.pdf
# архивы для загрузки в портал — производные, пересобираются скриптом
papers/*/submission/upload_*.zip

# MS Office lock/owner temp files (created while a .docx is open in Word)
~$*
