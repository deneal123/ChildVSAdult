# Internal service only. Use a long random value from your secret manager.
PROM_INTERNAL_TOKEN=replace-before-starting
DATABASE_URL=postgresql+psycopg://dating_prom:replace@postgres:5432/dating

# Model files are mounted read-only at this path. Runtime downloads are deliberately unsupported.
PROM_MODEL_MANIFEST=/app/models/manifest.json
PROM_ALLOWED_MEDIA_HOSTS=media.internal.example
PROM_MEDIA_MAX_BYTES=8388608
PROM_MEDIA_TIMEOUT_SECONDS=5
PROM_MIN_IMAGE_SIDE=160
PROM_MIN_BLUR_VARIANCE=12
PROM_WORKER_POLL_SECONDS=1
PROM_SERVICE_VERSION=1.0.0
