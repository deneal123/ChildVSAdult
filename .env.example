# Internal service only. Use a long random value from your secret manager.
PROM_INTERNAL_TOKEN=replace-before-starting
DATABASE_URL=postgresql+psycopg://dating_prom:replace@postgres:5432/dating

# Model files are materialised once by prom-model-init and mounted read-only by API/worker.
PROM_MODEL_MANIFEST=/app/models/manifest.json
PROM_MODEL_DIR=/app/models
PROM_MODEL_SOURCE_REPO=minchul/cvlface_adaface_ir50_webface4m
PROM_MODEL_SOURCE_FILE=pretrained_model/model.pt
PROM_MODEL_SOURCE_SHA256=43bd2d570584d95d4a17ce81f26449034c45dbeed750afcab651872abc0e1496
PROM_VISION_SOURCE_REPO=openai/clip-vit-base-patch32
PROM_VISION_SOURCE_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268
PROM_VISION_SOURCE_FILE=pytorch_model.bin
PROM_VISION_SOURCE_SHA256=a63082132ba4f97a80bea76823f544493bffa8082296d62d71581a4feff1576f
PROM_VISION_CONFIG_FILE=config.json
PROM_VISION_CONFIG_SHA256=b575ef3c36f2a057fa19e221650105052d61cc9c1a972ec15019c6261ec98770
PROM_MODEL_VERSION=clip-vit-b32--adaface-ir50-v1
PROM_ALLOWED_MEDIA_HOSTS=media.internal.example
PROM_MEDIA_MAX_BYTES=8388608
PROM_MEDIA_TIMEOUT_SECONDS=5
PROM_MIN_IMAGE_SIDE=160
PROM_MIN_BLUR_VARIANCE=12
PROM_WORKER_POLL_SECONDS=1
PROM_WORKER_LEASE_SECONDS=60
PROM_WORKER_MAX_ATTEMPTS=3
PROM_SERVICE_VERSION=1.0.0
